# VoyageRL configuration. Copy this file to .env and supply your own values.
# Never commit .env. This template contains no working credentials.
# Values are also valid for shell scripts that source .env.

# General OpenAI-compatible service: extraction, transport simulation, judging.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=your-assistant-model
JUDGE_MODEL_ID=your-judge-model

# Teacher service used by data_distill.py.
AGENT_API_KEY=
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL_ID=your-teacher-model
TOKENIZER_PATH=Qwen/Qwen3-4B-Instruct-2507

# Question expansion. Empty API key and URL entries are intentionally omitted:
# when unset, the script falls back to OPENAI_API_KEY / OPENAI_BASE_URL.
# EXPANSION_API_KEY=
# EXPANSION_BASE_URL=https://api.openai.com/v1
EXPANSION_MODEL=your-expansion-model

# Map/weather/POI/route tools. Obtain an AMap Web Service API key.
AMAP_MAPS_API_KEY=
MAX_POI_RESULTS=5

# Main web search and optional crawling service.
FIRECRAWL_API_KEY=
FIRECRAWL_SEARCH_LIMIT=5
SEARCH_MAX_RETRIES=3
SEARCH_TIMEOUT_SECONDS=30
FIRECRAWL_TIMEOUT_MS=30000

# Alternative providers, only needed when those tool modules are selected.
# Multiple keys are accepted as comma-separated values where supported.
TAVILY_API_KEY=
SERPAPI_API_KEY=
GOOGLE_MAX_RETRIES=2

# Web-page retrieval and extraction limits. Omit to use code defaults.
# VISIT_FETCH_MAX_RETRIES=2
# VISIT_FETCH_TIMEOUT=30
# VISIT_MAX_HTML_CHARS=2000000
# VISIT_MIN_EXTRACTED_CHARS=200
# VISIT_SERVER_MAX_RETRIES=3
# VISIT_SERVER_TIMEOUT=60
# WEBCONTENT_MAXLENGTH=24000
# VISIT_USER_AGENT=VoyageRL/1.0

# Inference metrics and prompt configuration.
INFERENCE_METRICS_PATH=outputs/inference_metrics.jsonl
TOOL_LOOP_SIMPLIFY_SYSTEM_PROMPT=1

# GRPO judge configuration: training scripts can derive these from OPENAI_*.
# Leave unset to retain the script's fallback behavior.
# JUDGE_API_KEY=
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_MODEL=your-judge-model
# JUDGE_TIMEOUT_SEC=30
# ANSWER_JUDGE_GOLD_DATASET_PATH=data/final/rl.jsonl

# Multi-turn rollout controls. Omit to use the scheduler defaults.
# TOOL_LOOP_TOOLS_DIR=tools
# TOOL_LOOP_SYSTEM_MAX_TOOL_CALLS=13
# TOOL_LOOP_MAX_NO_TOOL_NO_ANSWER_RETRIES=2
# TOOL_LOOP_MAX_INVALID_TOOL_ROUNDS=3
# TOOL_LOOP_MAX_SAME_TOOL_CALL_ROUNDS=3
# TOOL_LOOP_FORCE_ANSWER_AFTER_TURNS=12
# TOOL_LOOP_TOOL_RESPONSE_MAX_CHARS=5000
# TOOL_LOOP_TOOL_FIRST_ENFORCE=1

# Training paths, GPU layout, reward schedules and batch sizes are configured
# through the training scripts. Use absolute paths when overriding paths.
# MODEL_PATH=/absolute/path/to/model
# ADAPTER_PATH=/absolute/path/to/lora-checkpoint
# TRAIN_DATA=/absolute/path/to/sft_train.jsonl
# VAL_DATA=/absolute/path/to/sft_val.jsonl
# RL_DATASET=/absolute/path/to/rl.jsonl
# DATASET_PATH=/absolute/path/to/inference.jsonl
# OUTPUT_DIR=/absolute/path/to/training-output
# OUTPUT_PATH=/absolute/path/to/inference-output.jsonl
# NPROC_PER_NODE=4
# TRAIN_CUDA_VISIBLE_DEVICES=2,3,4,5,6,7
# ROLLOUT_CUDA_VISIBLE_DEVICES=0,1
# ROLLOUT_TP_SIZE=2
# VLLM_SERVER_HOST=127.0.0.1
# VLLM_SERVER_PORT=8000
# PARSER_REWARD_TOTAL_STEPS=200
# PARSER_REWARD_PHASE_RATIOS='[0.15, 0.2, 0.65]'
# PARSER_REWARD_W1='[0.10, 0.10, 0.05, 0.05, 0.10, 0.60]'
# PARSER_REWARD_W2='[0.05, 0.05, 0.05, 0.05, 0.10, 0.70]'
# PARSER_REWARD_W3='[0.05, 0.05, 0.05, 0.05, 0.05, 0.75]'
# PARSER_REWARD_DEBUG=1
# DEEP_RESEARCH_LOG_LEVEL=INFO

# Optional launcher overrides. These examples are not a tested hardware recipe;
# the active defaults for each stage are defined in its scripts/*.sh launcher.
# CUDA_VISIBLE_DEVICES=0,1,2,3
# REF_MODEL_PATH=/absolute/path/to/reference-model
# REWARD_PLUGIN=/absolute/path/to/reward-plugin.py
# SCHEDULER_PLUGIN=/absolute/path/to/scheduler-plugin.py
# MASTER_PORT=29511
# INFER_BACKEND=transformers
# START_IDX=0
# NUM_SAMPLES=1
# MAX_TURNS=13
# MAX_NEW_TOKENS=5000
# VLLM_GPU_MEMORY_UTILIZATION=0.8
# MAX_STEPS=200
# SAVE_STEPS=50
# LEARNING_RATE=1e-6
# PER_DEVICE_TRAIN_BATCH_SIZE=1
# GRADIENT_ACCUMULATION_STEPS=1
# NUM_GENERATIONS=6
# TEMPERATURE=0.9
# MAX_LENGTH=50000
# MAX_COMPLETION_LENGTH=5000
# NCCL_IB_DISABLE=1
# NCCL_P2P_DISABLE=0
